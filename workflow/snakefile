import os
import re

QUAL=config["QUAL"]
MINL=config["MINL"]
MAXL=config["MAXL"]
ID=config["ID"]
R_CLEANING=config["R_CLEANING"]
MINAB=config["MINAB"]
SUBSAMPLING=config["SUBSAMPLING"]
NUM_PROCESSES=config["NUM_PROCESSES"]
TREE=config["TREE"]
METADATA=config["METADATA"]
DATABASE=config["DATABASE"]
OUT=config["OUT"]
INPUT_DIR=config["INPUT_DIR"]
NANOASV_PATH=config["NANOASV_PATH"]
MOD=config["MOD"]
FASTTREE_MOD=config["FASTTREE_MOD"]
SAMQ=config["SAMQ"]

INPUT = glob_wildcards(os.path.join(INPUT_DIR, "{barcode}", "{FASTQ_FILE}.fastq.gz"))

DATABASE_NAME = re.sub(r"\.fasta(\.gz)?$", "", os.path.basename(DATABASE))
DATABASE_INDEX = f"tmp_files/00_database_indexing/{DATABASE_NAME}.mmi"
DATABASE_TAXONOMY = f"tmp_files/00_database_indexing/TAXONOMY_{DATABASE_NAME}"

rule all:
    input:
        expand("tmp_files/06_sam_to_bam_format/Taxonomy_{BARCODE}.csv", BARCODE=INPUT.barcode),
        "tmp_files/.rscript.done"



# Step 1/9 : Indexing of the database
rule database_indexing:
    input:
        DATABASE
    output:
        index=DATABASE_INDEX,
        taxonomy=DATABASE_TAXONOMY
    params:
        model=MOD
    threads: NUM_PROCESSES
    log:
        "tmp_files/logs/database_indexing.log"
    shell:
        """
        exec 2> {log:q}
        minimap2 -x {params.model} -t {threads} -d {output.index:q} {input:q}
        zcat -f {input:q} | grep "^>" | tr -d ">" > {output.taxonomy:q}
        """

# Step 2/9 : Concatenation of fastq files
rule concatenate_fastq_files:
    input:
        os.path.join(INPUT_DIR, "{barcode}", "")
    output:
        temporary("tmp_files/01_concatenate_fastq_files/{barcode}.fastq.gz")
    log:
        "tmp_files/logs/concatenate_fastq_files/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        if ls {input:q}/*.fastq 1> /dev/null 2>&1; then
            (gzip -c {input:q}/*.fastq 2>/dev/null; cat {input:q}/*.fastq.gz 2>/dev/null) > {output:q}
        else
            cat {input:q}/*.fastq.gz > {output:q}
        fi
        """


# Step 3/9 : Filtering sequences based on quality with Chopper
rule sequence_quality_filtering:
    input:
        "tmp_files/01_concatenate_fastq_files/{barcode}.fastq.gz"
    output:
        temporary("tmp_files/02_sequence_quality_filtering/FILTERED_{barcode}.fastq.gz")
    params:
        quality=QUAL,
        min_length=MINL,
        max_length=MAXL
    threads: NUM_PROCESSES
    log:
        "tmp_files/logs/sequence_quality_filtering/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        chopper -q {params.quality} -l {params.min_length} --maxlength {params.max_length} --threads {threads} -i {input:q} | gzip > {output:q}
        """


# Step 4/9 : Trim adapaters with Porechop
rule adapters_trimming:
    input:
        "tmp_files/02_sequence_quality_filtering/FILTERED_{barcode}.fastq.gz"
    output:
        temporary("tmp_files/03_adapters_trimming/CHOPED_{barcode}.fastq.gz")
    threads: NUM_PROCESSES
    log:
        "tmp_files/logs/adapters_trimming/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        porechop --verbosity 0 --threads {threads} -i {input:q} -o {output:q}
        """


# Step 5/9 : Subsampling
rule subsampling:
    input:
        "tmp_files/03_adapters_trimming/CHOPED_{barcode}.fastq.gz"
    output:
        "tmp_files/04_subsampling/SUBSAMPLED_{barcode}.fastq"
    params:
        lines=SUBSAMPLING
    log:
        "tmp_files/logs/subsampling/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        head -n {params.lines} < <(zcat {input:q}) > {output:q}
        """

rule minimap2:
    input:
        fastq_file="tmp_files/04_subsampling/SUBSAMPLED_{barcode}.fastq",
        index=DATABASE_INDEX
    output:
        temporary("tmp_files/05_minimap2/{barcode}.sam")
    params:
        model=MOD
    threads: NUM_PROCESSES
    log:
        "tmp_files/logs/minimap2/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        minimap2 -a -x {params.model} -t {threads} --seed 666 {input.index:q} {input.fastq_file:q} > {output:q}
        """

# Step 6/9 : Reads alignements with minimap2 against the database
rule sam_to_bam_format:
    input:
        sam_file="tmp_files/05_minimap2/{barcode}.sam",
        taxonomy=DATABASE_TAXONOMY
    output:
        taxonomy_file="tmp_files/06_sam_to_bam_format/Taxonomy_{barcode}.csv",
        ASV_list="tmp_files/06_sam_to_bam_format/{barcode}_ASV_list.tsv",
        unmatched_fastq="tmp_files/06_sam_to_bam_format/{barcode}_unmatched.fastq",
        abundance="tmp_files/06_sam_to_bam_format/{barcode}_abundance.tsv",
        exact_affiliations="tmp_files/06_sam_to_bam_format/{barcode}_Exact_affiliations.tsv"
    params:
        min_mapping_quality=SAMQ
    log:
        "tmp_files/logs/sam_to_bam_format/{barcode}.log"
    shell:
        """
        exec 2> {log:q}
        samtools fastq -f 4 {input.sam_file:q} | awk '{{if (NR%4==1) {{sub("^@", "@"); print $0 ";barcodelabel={wildcards.barcode}"}} else print $0}}' > {output.unmatched_fastq:q}

        samtools view -F UNMAP,SECONDARY,SUPPLEMENTARY -q {params.min_mapping_quality} {input.sam_file:q} | \
        tee >(cut -f 1,2,3,5 > {output.exact_affiliations:q}) | \
        cut -f 3 | sort | uniq -c | awk '$1 != 0' | sort -nr | \
        sed 's/^[[:space:]]*//' > {output.abundance:q}
        if [ ! -s {output.abundance:q} ]; then
            echo '1 XXX' >> {output.abundance:q}
            grep -Eo "[^ ]+$" {output.abundance:q} > {output.ASV_list:q}
            echo 'XXX XXX;XXX;XXX;XXX;XXX;SANITY'> {output.taxonomy_file:q}
        else
            grep -Eo "[^ ]+$" {output.abundance:q} > {output.ASV_list:q}
            awk 'NR == FNR {{ids[$1]; next}} $1 in ids' {output.ASV_list:q} {input.taxonomy:q} > {output.taxonomy_file:q}
        fi
        """

# Step 7/9 : Unknown sequences clustering with vsearch
rule vsearch:
    input:
        expand("tmp_files/06_sam_to_bam_format/{barcode}_unmatched.fastq", barcode=INPUT.barcode)
    output:
        "tmp_files/07_unknown_sequences_clustering/.vsearch.done"
    params:
        identity=ID,
        min_abundance=MINAB
    threads: NUM_PROCESSES
    log:
        "tmp_files/logs/vsearch.log"
    shell:
        """
        exec 2> {log:q}
        # not declared as outputs: they exist only when clusters are kept
        rm -f tmp_files/07_unknown_sequences_clustering/unknown_clusters.tsv tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta
        cat {input:q} > tmp_files/07_unknown_sequences_clustering/seqs
        UNIQ_ID=$(uuidgen)
        if [ -s "tmp_files/07_unknown_sequences_clustering/seqs" ]; then
            vsearch \
            --cluster_size tmp_files/07_unknown_sequences_clustering/seqs \
            --threads {threads} \
            --id {params.identity} \
            --iddef 4 \
            --relabel "${{UNIQ_ID}}_Unknown_cluster_" \
            --sizeout \
            --otutabout >(awk -v MINAB={params.min_abundance} \
                        'BEGIN {{FS = OFS = "\t"}}
                            NR == 1 {{print $0}}
                            NR > 1 {{s = 0
                                    for (i=2; i<=NF; i++) {{s += $i}}
                                    if (s >= MINAB) {{print $0}}
                            }}' > tmp_files/07_unknown_sequences_clustering/unknown_clusters.tsv) \
            --clusterout_sort \
            --fasta_width 0 \
            --quiet \
            --consout - | \
            sed -E '/^>/ s/;seqs=[0-9]+//' | \
            sed -E '/^>/ s/^>centroid=/>/' | \
            vsearch \
                --fastx_filter - \
                --sizein \
                --quiet \
                --minsize {params.min_abundance} \
                --fastaout tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta
            sed -i 's/;/_/g' tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta #Semicolons trigger format problem with tree file
            sed -E -i '/^>/ s/_size=[0-9]+//' tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta #Remove size information 
            rm tmp_files/07_unknown_sequences_clustering/seqs
            if [ $(wc -l < tmp_files/07_unknown_sequences_clustering/unknown_clusters.tsv) -lt 2 ]; then
                rm tmp_files/07_unknown_sequences_clustering/unknown_clusters.tsv tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta
            fi
        fi
        touch {output:q}
        """



# Phylogeny with MAFFT and FastTree (not run with --notree)
rule tree_reference_sequences:
    input:
        expand("tmp_files/06_sam_to_bam_format/{barcode}_ASV_list.tsv", barcode=INPUT.barcode)
    output:
        "tmp_files/08_phylogeny/ALL_ASV.fasta"
    params:
        database=DATABASE
    log:
        "tmp_files/logs/tree_reference_sequences.log"
    shell:
        """
        exec 2> {log:q}
        zcat -f {params.database:q} | awk 'NR == FNR {{ids[$1]; next}} /^>/ {{keep = (substr($1, 2) in ids)}} keep' <(cat {input:q}) - > {output:q}
        """

rule tree_input_sequences:
    input:
        reference_sequences="tmp_files/08_phylogeny/ALL_ASV.fasta",
        vsearch_done_file="tmp_files/07_unknown_sequences_clustering/.vsearch.done"
    output:
        "tmp_files/08_phylogeny/ALL_ASV_OTU.fasta"
    log:
        "tmp_files/logs/tree_input_sequences.log"
    shell:
        """
        exec 2> {log:q}
        cp {input.reference_sequences:q} {output:q}
        if [[ -e "tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta" ]]; then
            cat tmp_files/07_unknown_sequences_clustering/Consensus_seq_OTU.fasta >> {output:q}
        fi
        """

rule align_sequences:
    input:
        "tmp_files/08_phylogeny/ALL_ASV_OTU.fasta"
    output:
        "tmp_files/08_phylogeny/ALL_ASV.aln"
    threads: 20
    log:
        "tmp_files/logs/align_sequences.log"
    shell:
        """
        exec 2> {log:q}
        mafft --thread {threads} {input:q} > {output:q}
        """

rule build_tree:
    input:
        "tmp_files/08_phylogeny/ALL_ASV.aln"
    output:
        "tmp_files/08_phylogeny/ASV.tree"
    params:
        fasttree_model=FASTTREE_MOD
    log:
        "tmp_files/logs/build_tree.log"
    shell:
        """
        exec 2> {log:q}
        FastTree -nt -{params.fasttree_model} {input:q} > {output:q}
        """


# Export results
rule export_results:
    input:
        taxonomy_files=expand("tmp_files/06_sam_to_bam_format/Taxonomy_{barcode}.csv", barcode=INPUT.barcode),
        abundance_files=expand("tmp_files/06_sam_to_bam_format/{barcode}_abundance.tsv", barcode=INPUT.barcode),
        exact_affiliations_files=expand("tmp_files/06_sam_to_bam_format/{barcode}_Exact_affiliations.tsv", barcode=INPUT.barcode),
        vsearch_done_file="tmp_files/07_unknown_sequences_clustering/.vsearch.done",
        tree=["tmp_files/08_phylogeny/ASV.tree"] if TREE == 1 else []
    output:
        "tmp_files/.export.done"
    params:
        out=OUT
    log:
        "tmp_files/logs/export_results.log"
    shell:
        """
        exec 2> {log:q}
        mkdir -p {params.out:q}/Results/{{ASV,Tax,Unknown_clusters,Phylogeny,Exact_affiliations,CSV,Rdata}}
        cp {input.abundance_files:q} {params.out:q}/Results/ASV/
        cp {input.taxonomy_files:q} {params.out:q}/Results/Tax/
        cp {input.exact_affiliations_files:q} {params.out:q}/Results/Exact_affiliations/
        if [ -n "{input.tree}" ]; then
            cp {input.tree:q} {params.out:q}/Results/Phylogeny/
        fi
        if [ -e "tmp_files/07_unknown_sequences_clustering/unknown_clusters.tsv" ]; then
            cp tmp_files/07_unknown_sequences_clustering/{{unknown_clusters.tsv,Consensus_seq_OTU.fasta}} {params.out:q}/Results/Unknown_clusters/
        fi

        touch {output:q}
        """

# Phyloseq
rule phyloseq:
    input:
        "tmp_files/.export.done" 
    output:
        "tmp_files/.rscript.done"
    params:
        script=os.path.join(NANOASV_PATH, "workflow", "scripts", "script.r"),
        input_dir=INPUT_DIR,
        out=OUT,
        r_cleaning=R_CLEANING,
        tree=TREE,
        metadata=METADATA
    log:
        "tmp_files/logs/phyloseq.log"
    shell:
        """
        Rscript {params.script:q} {params.input_dir:q} {params.out:q} {params.r_cleaning} {params.tree} {params.metadata:q} 2>&1 | tee {log:q}
        touch {output:q}
        """
